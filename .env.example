# SWAP! - Example environment configuration
# Copy to .env.local (per app) and fill in real values. NEVER commit real secrets.
# The service-role key is SERVER-ONLY and must never appear in the mobile app.

# ---------------------------------------------------------------- Supabase ---
# Public (safe to ship in clients):
SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only (Edge Functions / admin backends). NEVER expose to the mobile app.
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
SUPABASE_DB_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ------------------------------------------------- Transactional email -------
# Provider: Postmark (see docs/email-deliverability.md). Server-only.
POSTMARK_SERVER_TOKEN="server-only-postmark-token"
POSTMARK_MESSAGE_STREAM="outbound"
EMAIL_FROM_ADDRESS="no-reply@mail.swapapp.example"
EMAIL_FROM_NAME="SWAP!"
# Shared secret used to verify inbound Postmark delivery/bounce webhooks.
POSTMARK_WEBHOOK_SECRET="server-only-webhook-secret"

# ------------------------------------------------- Google OAuth (Method A) ---
# Configured in the Supabase Auth dashboard AND here for reference. Server-only
# secret. See docs/school-verification.md for redirect URIs and scopes.
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="server-only-google-client-secret"

# ------------------------------------------------- Microsoft OAuth (Method B)-
MICROSOFT_OAUTH_CLIENT_ID="your-azure-app-client-id"
MICROSOFT_OAUTH_CLIENT_SECRET="server-only-azure-client-secret"
MICROSOFT_OAUTH_TENANT="common"

# --------------------------------------------------------------- OTP tuning --
OTP_LENGTH="6"
OTP_TTL_SECONDS="600"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_DAILY_CAP_PER_EMAIL="10"

# --------------------------------------------------------------- Local test --
# Used by scripts/db-*.sh. Defaults shown; override if your local PG differs.
SWAP_TEST_DB="swap_test"
SWAP_DEV_DB="swap_dev"
SWAP_ADMIN_DB="postgres"
