{
  "expo": {
    "name": "SWAP!",
    "slug": "swap-mobile",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "swap",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F8F5",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.replit.swap"
    },
    "android": {
      "package": "app.replit.swap"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "SWAP! uses your photo library so you can add photos to the items you post. Photos you attach to a listing are shared with verified students at your school."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
