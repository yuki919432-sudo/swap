{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "demo",
        "EXPO_PUBLIC_ENABLE_DEMO_MODE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "pilot",
        "EXPO_PUBLIC_ENABLE_DEMO_MODE": "false"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "pilot",
        "EXPO_PUBLIC_ENABLE_DEMO_MODE": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
