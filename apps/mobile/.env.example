# SWAP! mobile (Expo) — environment.
#
# Copy to `.env` for local development. All EXPO_PUBLIC_* vars are inlined into the
# client bundle at build time, so NEVER put secrets here.

# App mode: "demo" (default) or "pilot".
#   demo  = may use synthetic Mock data (dev/showcase).
#   pilot = real pilot/release build; NEVER uses demo data. If the backend below is
#           not configured, the app fails loudly (a "Backend not configured" screen)
#           instead of silently falling back to demo data.
EXPO_PUBLIC_APP_MODE=demo

# Enable the development-only demo mode (synthetic data + local demo session).
# Demo mode additionally requires a development runtime, so it is unavailable in
# production builds even if this is set to "true". Ignored when APP_MODE=pilot.
EXPO_PUBLIC_ENABLE_DEMO_MODE=true

# Real backend (optional). When BOTH are set, the app uses the Supabase-backed
# repositories once a user signs in; otherwise it stays in demo mode. The anon key
# is a PUBLIC key (RLS is the real authority) — never put a service-role key here.
# For a local stack, use the values from `supabase status`.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Optional: the pilot school's id. When set, onboarding offers a manual-approval
# request for students without an invitation code. Empty = manual fallback shows a
# support/contact path instead. Do not hardcode a school domain globally.
EXPO_PUBLIC_PILOT_SCHOOL_ID=""
